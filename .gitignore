videos/
*.mp4
*.mov
*.avi
*.mkv

# ── Analysis output ───────────────────────────────────────────────────────────
# output.csv is committed as an empty header template; real results stay local
results/
*_results.csv

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── VS Code ───────────────────────────────────────────────────────────────────
.vscode/

